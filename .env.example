# Proyecto Supabase del juego: base de datos, Realtime (presencia de jugadores) y la Edge Function `game`.
VITE_SUPABASE_URL=https://cyyetwpqyhoreyyefuda.supabase.co
VITE_SUPABASE_ANON_KEY=

# Servidor del juego. Si falta, lib/api.ts cae al proyecto de arriba por defecto, pero conviene fijarla
# explícitamente en el build para que un cambio de proyecto no dependa de un valor escrito en el código.
VITE_GAME_URL=https://cyyetwpqyhoreyyefuda.supabase.co/functions/v1/game

# Coliseo Monad (módulo educativo). Dirección del AcademyGatekeeper desplegado en Monad testnet
# (chainId 10143). Sin ella el coliseo funciona en modo demostración: la puerta se abre firmando un
# mensaje y la insignia se guarda en el navegador en vez de acuñarse on-chain.
#   forge create contracts/AcademyGatekeeper.sol:AcademyGatekeeper \
#     --rpc-url https://testnet-rpc.monad.xyz --private-key $PK --broadcast
VITE_ACADEMY_CONTRACT=
